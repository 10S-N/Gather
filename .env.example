# ---------------------------------------------------------------------------
# Gather — environment variables
# Copy to .env.local (git-ignored). Only VITE_* values are exposed to the
# browser; everything else is read by the sync CLI / serverless handler only.
# ---------------------------------------------------------------------------

# Optional: large-venue listings pulled directly from the browser.
VITE_TICKETMASTER_KEY=

# Optional. The "Run sync now" button runs in the browser by default; this is
# only used by triggerSync() when you deploy api/sync.js.
VITE_SYNC_ENDPOINT=/api/sync

# Comma-separated Firebase uids allowed to see/trigger /admin/sync. The same
# uids must be listed in isIngestionAdmin() inside firestore.rules — that is what
# authorizes browser write runs. Add one with:
#   npm run admin:grant -- <your-firebase-uid>
# which edits this file and firestore.rules together.
VITE_ADMIN_UIDS=

# Browser-run defaults for /admin/sync. Only set VITE_EVENTBRITE_API_KEY if you
# accept that the private token ships in the JS bundle — otherwise paste it into
# the form at run time (held in memory only). VITE_EVENTBRITE_ORGANIZERS is the
# reliable Eventbrite path; without it the adapter tries Austin public search,
# which Eventbrite retired for new apps. VITE_SYNC_FIXTURES=1 adds four
# clearly-labelled demo events so you can populate Firestore with no credentials.
VITE_EVENTBRITE_API_KEY=
# Discovery locality ids; empty uses Austin (101724577).
VITE_EVENTBRITE_PLACES=
VITE_EVENTBRITE_ORGANIZERS=
VITE_EVENTBRITE_MAX_EVENTS=20
VITE_LUMA_CALENDARS=
VITE_RSS_FEEDS=
# Extra community calendars (public event pages with schema.org Event markup or
# an ?ical=1 export). The built-in Austin calendars always run.
VITE_CALENDAR_URLS=
# Set to off to skip the built-in Austin calendars in a browser run.
VITE_CALENDAR_DEFAULTS=on
# How many Do512 day pages the browser run reads (1–21, default 7).
VITE_DO512_DAYS=7
VITE_SYNC_FIXTURES=

# ---------------------------------------------------------------------------
# Ingestion (server-side only — never prefix these with VITE_)
# ---------------------------------------------------------------------------

# Firebase Admin credentials. Use ONE of:
#   FIREBASE_SERVICE_ACCOUNT='{"type":"service_account", ...}'   (inline JSON)
#   GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/service-account.json
FIREBASE_SERVICE_ACCOUNT=
GOOGLE_APPLICATION_CREDENTIALS=

# Eventbrite (https://www.eventbrite.com/platform/api-keys)
# Needs a PRIVATE token: Account Settings → Developer Links → API Keys →
# "Create API Key". The long string under "Private token" is the one to use.
# The 20-character "public key" only works for OAuth in the browser and gets a
# 403 from the API, so the sync will skip Eventbrite if that is all you have.
# EVENTBRITE_ORGANIZERS is strongly recommended: Eventbrite retired public event
# discovery search (POST /v3/destination/search/), the same one the public site
# uses. The documented GET /v3/events/search/ is retired and 404s, so it is not
# used. Leave EVENTBRITE_ORGANIZERS empty unless you specifically want one
# organizer's listings.
EVENTBRITE_API_KEY=
# Alias kept for older setups; EVENTBRITE_API_KEY wins when both are set.
EVENTBRITE_API_TOKEN=
# Discovery locality ids (Eventbrite place ids). Default is Austin (101724577).
EVENTBRITE_PLACES=
# Optional: follow organizers through the v3 org endpoint instead of discovery.
# Takes precedence over discovery when set. Comma-separated ids.
EVENTBRITE_ORGANIZERS=
# Optional: keep only these discovery category labels (or numeric ids), e.g.
# "Music,Community & Culture". Default drops Business, Fashion, and Auto.
# Set "all" to keep every category.
EVENTBRITE_CATEGORIES=
# Optional: events per run (default 60, max 100).
EVENTBRITE_MAX_EVENTS=60

# Do512 (https://do512.com/events) — public HTML, no credentials needed. This
# is the source that works on a fresh clone and produces real Austin listings.
# Day pages read per run: 1–21, default 7.
DO512_DAYS=7

# Community calendars: public event pages with schema.org Event JSON-LD or an
# iCal export. The built-in Austin seeds (The Austin Common, Austin Parks
# Foundation, Sustainable Food Center, Wildflower Center, Shalom Austin,
# Austin Bat Cave) run with no configuration; this appends more. To run ONLY
# the URLs listed here, set CALENDAR_DEFAULTS=off.
# UT Austin's public calendar also works if you want a campus feed:
#   CALENDAR_URLS=https://calendar.utexas.edu/
CALENDAR_URLS=
CALENDAR_DEFAULTS=on

# Luma calendars: full iCalendar URLs only, e.g. a calendar you exported from
# Luma. The old lu.ma/<slug>/ics shortcut no longer returns a feed (it answers
# with the calendar's web page), so the adapter fails loudly if you use it.
LUMA_CALENDARS=

# Any RSS 2.0 / Atom event feeds (neighborhood blogs, galleries, DIY spaces).
RSS_FEEDS=

# Serverless trigger security (/api/sync)
# ADMIN_UIDS / ADMIN_EMAILS gate the signed-in "Run sync now" button.
ADMIN_UIDS=
ADMIN_EMAILS=
# SYNC_SECRET lets a scheduler POST without a user session.
SYNC_SECRET=
