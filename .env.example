# ---------------------------------------------------------------------------
# Gather — environment variables
# Copy to .env.local (git-ignored). Only VITE_* values are exposed to the
# browser; everything else is read by the sync CLI / serverless handler only.
# ---------------------------------------------------------------------------

# Optional: large-venue listings pulled directly from the browser.
VITE_TICKETMASTER_KEY=

# Optional. The "Run sync now" button runs in the browser by default; this is
# only used by triggerSync() when you deploy api/sync.js.
VITE_SYNC_ENDPOINT=/api/sync

# Comma-separated Firebase uids allowed to see/trigger /admin/sync. The same
# uids must be listed in isIngestionAdmin() inside firestore.rules — that is what
# authorizes browser write runs. Add one with:
#   npm run admin:grant -- <your-firebase-uid>
# which edits this file and firestore.rules together.
VITE_ADMIN_UIDS=

# Browser-run defaults for /admin/sync (public values only — they ship in the
# bundle). The Eventbrite token is pasted into the form at run time instead of
# being bundled. VITE_SYNC_FIXTURES=1 adds four clearly-labelled demo events so
# you can populate Firestore with no third-party credentials.
VITE_EVENTBRITE_ORGANIZERS=
VITE_LUMA_CALENDARS=
VITE_RSS_FEEDS=
VITE_SYNC_FIXTURES=

# ---------------------------------------------------------------------------
# Ingestion (server-side only — never prefix these with VITE_)
# ---------------------------------------------------------------------------

# Firebase Admin credentials. Use ONE of:
#   FIREBASE_SERVICE_ACCOUNT='{"type":"service_account", ...}'   (inline JSON)
#   GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/service-account.json
FIREBASE_SERVICE_ACCOUNT=
GOOGLE_APPLICATION_CREDENTIALS=

# Eventbrite (https://www.eventbrite.com/platform/api)
# EVENTBRITE_ORGANIZERS is strongly recommended: the public search endpoint is
# limited on newer apps, while organizer event lists are stable.
EVENTBRITE_API_TOKEN=
EVENTBRITE_ORGANIZERS=
EVENTBRITE_CATEGORIES=

# Luma calendars: slugs ("austinindie") or full ICS URLs
# ("https://lu.ma/austinindie/ics"). Find the slug in the calendar URL.
LUMA_CALENDARS=

# Any RSS 2.0 / Atom event feeds (neighborhood blogs, galleries, DIY spaces).
RSS_FEEDS=

# Serverless trigger security (/api/sync)
# ADMIN_UIDS / ADMIN_EMAILS gate the signed-in "Run sync now" button.
ADMIN_UIDS=
ADMIN_EMAILS=
# SYNC_SECRET lets a scheduler POST without a user session.
SYNC_SECRET=
